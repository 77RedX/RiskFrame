PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/riskframe
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PYTHON_QUANT_URL=http://127.0.0.1:5001
# Generate JWT_SECRET locally using Node crypto.randomBytes; never commit the actual value.

# Optional backend-only AI copilot. Set a private API key to enable it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Compose reads this file explicitly and forwards these settings only to Python.
# For direct Python startup, put them in the root .env instead.
DATABASE_URL=sqlite:///local_fallback.db
HF_MODEL_REPO=redx-was-taken/RiskFrame
HF_TOKEN=
